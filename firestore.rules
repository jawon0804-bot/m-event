rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // [2026-07-11 재작성] 이전 규칙은 대부분 "if true"라 로그인 여부와
    // 무관하게 아무나 읽고/쓸 수 있었음. loginWithCredentials가 이미
    // center_name/active 커스텀 클레임을 Firebase Auth 토큰에 심어주고
    // 있으므로, 여기서 request.auth.token.center_name으로 실제 접근
    // 제어를 건다. M-SMART/m-event 프론트엔드는 이미 로그인 후 커스텀
    // 토큰으로 signInWithCustomToken을 호출하고 있어서 앱 코드 변경 불필요.
    // Admin SDK(Cloud Functions, Dashboard의 server.js, M-Engine)는 이
    // 규칙 자체를 우회하므로 서버 쪽 동작에는 영향 없음.
    // ============================================================

    // inspection_logs: M-SMART가 브라우저에서 직접 씀, m-event가 읽음.
    // 로그인 필수 + 자기 센터 데이터만 쓰기/읽기 (Master는 전체 열람).
    // 수정/삭제는 클라이언트에서 불가 — 필요하면 Admin SDK/Functions만.
    // ⚠️ [2026-08-01 추가] worker(작업자 이름)를 토큰 클레임과 대조한다.
    //   예전엔 center_name만 봤다. worker는 M-SMART가 localStorage의 userName을
    //   그대로 넣는 값이라, 그걸 바꾸면 **남의 이름으로 점검 기록을 만들 수 있었다.**
    //   토큰의 name은 loginWithCredentials가 서버에서 심는 값이라 위조가 안 된다.
    //   부정점검 방지 수단으로 위치(location)를 기록해왔는데 2026-08-01에 속도
    //   문제로 그걸 껐기 때문에, 작업자 신원 검증의 비중이 그만큼 커졌다.
    //   → M-SMART submit.js가 이 규칙보다 **먼저** 토큰 기반 worker를 보내도록
    //     배포됐다(커밋 순서 중요 — 반대로 하면 제출이 막혀 오프라인 큐에 갇힌다).
    match /inspection_logs/{doc} {
      allow create: if request.auth != null
        && request.resource.data.center_name == request.auth.token.center_name
        && request.resource.data.worker == request.auth.token.name;
      allow read: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
      allow update, delete: if false;
    }

    // events: 생성은 onInspectionLog 트리거(Admin SDK)만 함.
    // 상태 변경(진행중/완료)은 m-event 화면이 클라이언트에서 직접 update.
    //
    // ⚠️ [2026-07-29 수정] update가 `resource.data`(수정 **전** 값)만 보고 있었다.
    //   그래서 자기 센터 이벤트를 수정하면서 center_name을 남의 센터로 바꿔 넘기면
    //   그대로 통과했고, 그 문서는 우리 센터 화면에서 사라져 남의 센터로 넘어갔다.
    //   (create는 처음부터 request.resource.data를 검사하고 있어서 update만 빠진 상태)
    //   → center_name을 불변으로 고정한다. 클라이언트가 이 필드를 안 보내면
    //     request.resource.data.center_name은 기존 값 그대로라 정상 동작에는 영향 없다.
    match /events/{doc} {
      allow read: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
      allow update: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master")
        && request.resource.data.center_name == resource.data.center_name;
      allow create, delete: if false;
    }

    // UserDB: 이름/전화번호/이메일 PII. loginWithCredentials가 Admin SDK로만
    // 조회하므로(functions/lib/auth.js) 클라이언트가 직접 읽을 이유가
    // 없음 — 완전 차단.
    // (2026-07-29: 참조가 "functions/index.js:841"로 적혀 있었으나 07-11 리팩토링으로
    //  index.js는 77줄짜리 진입점만 남았다 — 실제 위치는 lib/auth.js다)
    match /UserDB/{doc} {
      allow read, write: if false;
    }

    // center_configs/{center}/...: M-SMART가 자기 센터 점검표(checklists)를 읽음.
    match /center_configs/{center}/{document=**} {
      allow read: if request.auth != null
        && (request.auth.token.center_name == center
            || request.auth.token.center_name == "Master");
      allow write: if false;
    }

    // Maxerve_Excel: m-event 엑셀 탭이 클라이언트에서 직접 읽음.
    match /Maxerve_Excel/{doc} {
      allow read: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
      allow write: if false;
    }

    // schedule_logs: M-Engine 내부 트러블슈팅용, 클라이언트 접근 불필요.
    match /schedule_logs/{doc} {
      allow read, write: if false;
    }

    // settings/all_centers: 전체 센터 이름 목록. Master 화면의 센터 드롭다운에만 쓰인다.
    //
    // ⚠️ [2026-08-01 축소] 예전엔 `if request.auth != null`이라 **소속과 무관하게
    //   로그인만 하면 전 센터 목록이 열렸다.** 실제로 이 값을 쓰는 곳은 manager/js/auth.js의
    //   buildCenterFilters()뿐이고, 거기서도 isMaster일 때만 드롭다운에 채운다
    //   (일반 사용자는 자기 센터 하나로 고정). 그래서 Master로 좁혀도 기능 변화가 없다.
    //   같은 커밋에서 클라이언트도 Master가 아니면 아예 조회하지 않도록 바꿨다.
    //   M-Engine·Functions는 Admin SDK라 이 규칙을 우회하므로 영향 없다.
    match /settings/{doc=**} {
      allow read: if request.auth != null
        && request.auth.token.center_name == "Master";
      allow write: if false;
    }

    // work_logs: 근무일지, 자기 센터만 읽기/쓰기 가능.
    match /work_logs/{docId} {
      allow read: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
      allow create: if request.auth != null
        && (request.resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
      // events와 같은 이유로 center_name을 불변 고정 (2026-07-29)
      allow update: if request.auth != null
        && (resource.data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master")
        && request.resource.data.center_name == resource.data.center_name;
      allow delete: if false;
    }
    // 하위 컬렉션(dayWork/dayCheck/nightWork/nightNote/legal/material)이 근무일지의
    // 실제 내용이다. 부모 문서는 delete가 막혀 있는데 여기는 write(=create/update/delete)로
    // 열려 있어 **비대칭으로 보이지만 이건 의도된 설계다.**
    //
    // ✅ [2026-08-01 확인] 삭제를 막으려다 확인해보니 화면이 실제로 이 delete를 쓴다 —
    //   manager/js/worklog.js의 wlDeleteLine()("이 줄을 삭제하시겠습니까?"). 즉
    //   **줄 단위 삭제는 정상 기능**이고, 규칙을 조이면 그 기능이 깨진다.
    //   의미도 일관적이다: 자기 센터 근무일지의 줄은 고치고 지울 수 있지만,
    //   그 날짜 문서 자체를 통째로 없애지는 못한다.
    //   → 손대지 말 것. "비대칭이니 막자"는 판단은 기능을 깨뜨린다.
    match /work_logs/{docId}/{sub=**} {
      allow read, write: if request.auth != null
        && (get(/databases/$(database)/documents/work_logs/$(docId)).data.center_name == request.auth.token.center_name
            || request.auth.token.center_name == "Master");
    }

    // login_attempts / login_lockouts: 전화번호·IP 등 PII 포함, Admin SDK
    // (Cloud Functions)만 접근. 명시적으로 차단해서 의도를 분명히 함
    // (이전엔 규칙 자체가 없어 default-deny로 우연히 막혀있었을 뿐이었음).
    match /login_attempts/{doc} {
      allow read, write: if false;
    }
    match /login_lockouts/{doc} {
      allow read, write: if false;
    }
    match /login_lockouts_ip/{doc} {
      allow read, write: if false;
    }

    match /_monitor/{document=**} {
      allow read, write: if false;
    }
  }
}